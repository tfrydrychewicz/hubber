{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!dist",
      "!node_modules",
      "!diagnostics",
      "!test-results",
      "!playwright-report",
      "!package-lock.json",
      "!.claude"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useImportExtensions": "error"
      },
      "style": {
        "noUnusedTemplateLiteral": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/shared/**", "src/web/**", "!**/*.test.ts", "!**/*.test.tsx", "!src/web/test/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    },
    {
      "includes": ["src/shared/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "src/shared runs in Node and in the browser.",
                  "document": "src/shared runs in Node and in the browser.",
                  "process": "src/shared runs in Node and in the browser."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "Tests of src/shared run in Node, where there is no DOM.",
                  "document": "Tests of src/shared run in Node, where there is no DOM."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/server/**"],
                    "message": "The web app talks to the server over /api only."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/server/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/web/**"],
                    "message": "The server must not import browser code."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/server/**", "**/web/**"],
                    "message": "src/shared is imported by both sides and must not depend on either."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["e2e/**/*.spec.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@playwright/test": {
                    "importNames": ["test", "expect", "default", "*"],
                    "message": "Import test and expect from ./fixtures.ts, which fails a test when its page reports a problem."
                  },
                  "playwright/test": {
                    "importNames": ["test", "expect", "default", "*"],
                    "message": "Import test and expect from ./fixtures.ts, which fails a test when its page reports a problem."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.svg"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
